# Authoritative dist-exclude list. Mirrors the negative `src:` patterns in
# Gruntfile.js's `copy.dist` task so any tool that reads .distignore
# (wp-plugin-qa, WordPress.org SVN tagging, third-party packagers) gets
# the same view of what ships as the actual ZIP produced by `grunt dist`.
# When in doubt, Gruntfile.js is the source of truth — keep this in lockstep.

# Git / CI
/.git
/.github
/.gitignore
/.gitattributes

# Node + Composer + build artifacts
/node_modules
/vendor
/dist
/build/.phpcs-cache
/.phpunit.result.cache
/.phpunit.cache

# Dev tooling never shipped to customers
/bin
/tools
/tests
/test-results
/.claude
/playwright.config.ts

# Source we don't ship (src/blocks/ block CSS is loaded from build/ at runtime,
# so src/ stays excluded). RTL + minified CSS/JS are produced by Grunt into
# assets/ and bundled there instead.
/src

# Dev config files
/.editorconfig
/.distignore
/phpcs.xml
/.phpcs.xml.dist
/phpunit.xml
/phpunit.xml.dist
/phpstan.neon
/phpstan.neon.dist
/phpstan-baseline.neon
/composer.json
/composer.lock
/package.json
/package-lock.json
/webpack.config.js
/Gruntfile.js

# Docs, plans, audit, QA, marketing — internal / GitHub-only
/CLAUDE.md
/ARCHITECTURE.md
/docs
/plan
/plans
/audit
/qa
/marketing
*.md
!readme.txt

# One-off seed / cleanup scripts that ride the repo for dev convenience
/seed-demo-data.php
/cleanup-demo-data.php
/populate-showcase.php
