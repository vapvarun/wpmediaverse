# Authoritative dist-exclude list. Mirrors the negative `src:` patterns in
# Gruntfile.js's `copy.dist` task so any tool that reads .distignore
# (wp-plugin-qa, WordPress.org SVN tagging, third-party packagers) gets
# the same view of what ships as the actual ZIP produced by `grunt dist`.
# When in doubt, Gruntfile.js is the source of truth — keep this in lockstep.

# Git / CI
/.git
/.github
/.gitignore
/.gitattributes

# Node + Composer + build artifacts.
#
# /vendor is dev and build tooling ONLY and correctly excluded. That was not
# always true: it used to hold the runtime dependencies too, while the Gruntfile
# copied them — so a zip built from this file had no autoloader and every page,
# including the Plugins screen, returned 500 with no way back but FTP. The
# runtime dependencies now live committed under libs/, which SHIPS and must
# never be added here.
/node_modules
/vendor
/dist
/build/.phpcs-cache
/.phpunit.result.cache
/.phpunit.cache

# Dev tooling never shipped to customers
/bin
/tools
/tests
/test-results
/.claude
/playwright.config.ts

# Source we don't ship (src/blocks/ block CSS is loaded from build/ at runtime,
# so src/ stays excluded). RTL + minified CSS/JS are produced by Grunt into
# assets/ and bundled there instead.
/src

# Dev config files
/.editorconfig
/.distignore
/phpcs.xml
/.phpcs.xml.dist
/phpunit.xml
/phpunit.xml.dist
/phpstan.neon
/phpstan.neon.dist
/phpstan-baseline.neon
/composer.json
/composer.lock
/package.json
/package-lock.json
/webpack.config.js
/Gruntfile.js

# Docs, plans, audit, QA, marketing — internal / GitHub-only
/CLAUDE.md
/ARCHITECTURE.md
/docs
/plan
/plans
/audit
/qa
/marketing
*.md
!readme.txt

# Dev-only showcase script. The seeder and its cleanup companion are NOT listed
# here and must not be: `Admin\OverviewPage` requires seed-demo-data.php at
# line 655 and cleanup-demo-data.php at 682 to serve the "Import Demo Data"
# button. Excluding them shipped a button with no file behind it. This file and
# the Gruntfile disagreed about exactly that — the Gruntfile was right, and says
# so in a comment ("keep seed + cleanup for customer demo import").
/populate-showcase.php
