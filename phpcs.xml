<?xml version="1.0"?>
<ruleset name="WPMediaVerse">
	<description>Custom PHPCS ruleset for WPMediaVerse plugin.</description>

	<!-- Scan these files -->
	<file>.</file>

	<!-- Exclude directories -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<!-- Use WordPress standards -->
	<rule ref="WordPress">
		<!-- Allow PSR-4 file naming (Composer autoload) -->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<!-- Register custom capabilities -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="upload_mvs_media"/>
				<element value="edit_mvs_media"/>
				<element value="edit_mvs_medias"/>
				<element value="edit_others_mvs_media"/>
				<element value="edit_others_mvs_medias"/>
				<element value="delete_mvs_media"/>
				<element value="delete_mvs_medias"/>
				<element value="delete_others_mvs_media"/>
				<element value="delete_others_mvs_medias"/>
				<element value="moderate_mvs_media"/>
				<element value="manage_mvs_settings"/>
				<element value="read_mvs_media"/>
				<element value="publish_mvs_media"/>
				<element value="publish_mvs_medias"/>
				<element value="read_private_mvs_medias"/>
			</property>
		</properties>
	</rule>

	<!-- Set minimum WP version for deprecated function checks -->
	<config name="minimum_wp_version" value="6.5"/>

	<!-- Text domain -->
	<config name="text_domain" value="wpmediaverse"/>

	<!-- Prefixes -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="mvs_"/>
				<element value="MVS_"/>
				<element value="WPMediaVerse"/>
			</property>
		</properties>
	</rule>
</ruleset>
