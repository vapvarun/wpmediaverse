{
  "name": "wpmediaverse",
  "version": "1.4.0",
  "private": true,
  "description": "Complete media platform for WordPress.",
  "author": "WBCom Designs",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build/blocks --experimental-modules",
    "start": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build/blocks --experimental-modules",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "audit:mobile": "node bin/mobile-audit.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.0.0",
    "@wordpress/icons": "^13.0.0",
    "@wordpress/scripts": "^30.0.0",
    "grunt": "^1.6.1",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-compress": "^2.0.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-cssmin": "^5.0.0",
    "grunt-contrib-uglify": "^5.2.2",
    "grunt-rtlcss": "^2.0.2",
    "grunt-wp-i18n": "^1.0.4"
  },
  "dependencies": {
    "@wordpress/interactivity": "^6.0.0",
    "rtlcss": "^4.3.0"
  }
}
