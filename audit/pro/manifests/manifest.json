{
 "$schema": "https://wpmediaverse.com/schemas/wp-plugin-manifest-v2.json",
 "plugin": {
  "slug": "wpmediaverse-pro",
  "name": "WPMediaVerse Pro",
  "version": "1.2.0",
  "namespace": "WPMediaVersePro",
  "main_file": "wpmediaverse-pro.php",
  "text_domain": "wpmediaverse-pro",
  "requires_php": "7.4",
  "requires_wp": "6.5",
  "extends": "wpmediaverse",
  "extension_hook_consumed": "mvs_loaded",
  "extension_hook_fired": "mvs_pro_loaded",
  "license_provider": "EDD Software Licensing",
  "license_item_id": 1660828
 },
 "extension_patterns": [
  {
   "pattern": "Entry hook",
   "detail": "Pro hooks into do_action('mvs_loaded') fired by Free; runs Plugin::init then fires mvs_pro_loaded"
  },
  {
   "pattern": "Free service access",
   "detail": "Plugin::free_service('key') delegates to Free's ServiceContainer; returns null safely if missing"
  },
  {
   "pattern": "Admin tab injection",
   "detail": "Filters mvs_moderation_tabs (User Reports), mvs_stats_tabs (Video Analytics)"
  },
  {
   "pattern": "Storage drivers",
   "detail": "add_filter('mvs_storage_driver') returns S3 or BunnyCDN driver instance"
  },
  {
   "pattern": "AI providers",
   "detail": "add_action('mvs_ai_providers') registers GoogleVision/Rekognition on the AIService"
  },
  {
   "pattern": "Pro boundary",
   "detail": "Never import Free classes directly. Exception: WPMediaVerse\\Repository\\MediaRepository (acknowledged tech debt)"
  }
 ],
 "rest": {
  "namespace": "mvs-pro/v1",
  "endpoints": [
   {
    "route": "/connectors",
    "methods": [
     "GET"
    ],
    "handler": "Connectors/ConnectorRESTController::list_connectors",
    "permission": "logged-in",
    "purpose": "List available connectors"
   },
   {
    "route": "/connectors/(?P<id>[\\w-]+)/connect",
    "methods": [
     "POST"
    ],
    "handler": "Connectors/ConnectorRESTController::start_connect",
    "permission": "logged-in",
    "purpose": "Begin OAuth/connect flow"
   },
   {
    "route": "/connectors/(?P<id>[\\w-]+)/disconnect",
    "methods": [
     "POST"
    ],
    "handler": "Connectors/ConnectorRESTController::do_disconnect",
    "permission": "connected",
    "purpose": "Disconnect platform"
   },
   {
    "route": "/connectors/(?P<id>[\\w-]+)/status",
    "methods": [
     "GET"
    ],
    "handler": "Connectors/ConnectorRESTController::get_status",
    "permission": "connected",
    "purpose": "Connection status"
   },
   {
    "route": "/connectors/(?P<id>[\\w-]+)/browse",
    "methods": [
     "GET"
    ],
    "handler": "Connectors/ConnectorRESTController::browse_remote",
    "permission": "connected",
