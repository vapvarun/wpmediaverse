    "permission": "public read; admin create",
    "purpose": "Challenges list/create"
   },
   {
    "route": "/challenges/(?P<id>\\d+)",
    "methods": [
     "GET"
    ],
    "handler": "Challenges/ChallengeController::get_item",
    "permission": "public",
    "purpose": "Challenge detail"
   },
   {
    "route": "/challenges/(?P<id>\\d+)/cancel",
    "methods": [
     "POST"
    ],
