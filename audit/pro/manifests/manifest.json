  "uploads_gate": "Inherits Free's .htaccess deny-all on /wp-content/uploads/wpmediaverse/",
  "url_signing": "Calls into Free's MediaUrl::for_file / for_thumbnail / resolve and SignedUrlService",
  "cover_image_url_handling": "ChallengeService + TournamentService format methods route stored URLs through MediaUrl::resolve and fall back to most-recent entry's signed thumbnail",
