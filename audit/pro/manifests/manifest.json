    "permission": "logged-in",
    "purpose": "Vote on entry"
   },
   {
    "route": "/challenges/(?P<id>\\d+)/results",
    "methods": [
     "GET"
    ],
    "handler": "Challenges/ChallengeController::get_results",
    "permission": "public",
    "purpose": "Challenge results"
   },
   {
    "route": "/tournaments",
