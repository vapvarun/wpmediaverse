    "purpose": "Sideload import remote media"
   },
   {
    "route": "/connectors/(?P<id>[\\w-]+)/sync-delta",
    "methods": [
     "POST"
    ],
    "handler": "Connectors/ConnectorRESTController::sync_delta",
    "permission": "connected",
    "purpose": "Incremental sync since last import"
   },
   {
    "route": "/battles",
    "methods": [
     "GET",
     "POST"
    ],
    "handler": "Battles/BattleController",
    "permission": "public read; logged-in create",
