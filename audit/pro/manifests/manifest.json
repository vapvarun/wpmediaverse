 "feature_toggles": [
  {
   "option": "mvs_battles_enabled",
   "default": "0",
   "controls": "1v1 photo battles UI + BattleService + BattleController + BattleMonitor"
  },
  {
   "option": "mvs_challenges_enabled",
   "default": "0",
   "controls": "Challenges + ChallengeService + AutopilotService + ChallengeManager"
  },
  {
   "option": "mvs_tournaments_enabled",
   "default": "0",
   "controls": "Tournaments + TournamentService + TournamentController + TournamentManager"
  },
  {
   "option": "mvs_boosts_enabled",
   "default": "0",
   "controls": "BoostService + BoostController"
  },
  {
   "option": "mvs_streaks_enabled",
   "default": "0",
   "controls": "Streak badge UI (StreakService always loads; toggle gates UI only)"
  },
  {
   "option": "mvs_connectors_enabled",
   "default": "0",
   "controls": "Platform connectors + ConnectorManager + FlickrConnector"
  },
  {
   "option": "mvs_pro_transcode_enabled",
   "default": "0",
   "controls": "Video transcoding pipeline via FFmpeg"
  }
 ],
 "subsystems": [
  {
   "namespace": "Battles",
   "key_classes": [
    "BattleService",
    "BattleController"
   ],
   "purpose": "1v1 photo battles, voting, winner selection"
  },
  {
   "namespace": "Challenges",
   "key_classes": [
    "ChallengeService",
    "ChallengeController",
    "AutopilotService"
   ],
   "purpose": "Themed weekly photo challenges; weekly cron auto-creates + crowns winners"
  },
  {
   "namespace": "Tournaments",
   "key_classes": [
    "TournamentService",
    "TournamentController"
   ],
   "purpose": "Single-elimination brackets, round orchestration"
  },
  {
   "namespace": "Boosts",
   "key_classes": [
    "BoostService",
    "BoostController"
   ],
   "purpose": "Spend points to boost media impressions"
  },
  {
   "namespace": "Streaks",
   "key_classes": [
    "StreakService"
   ],
   "purpose": "Daily upload streaks + streak badges"
  },
  {
   "namespace": "Video",
   "key_classes": [
    "VideoController",
    "ChapterService",
    "ResumeService",
    "TranscodeService",
    "TranscodeController"
   ],
   "purpose": "Chapters, resume playback, FFmpeg transcoding"
  },
  {
   "namespace": "Captions",
   "key_classes": [
    "CaptionController",
    "TranscriptionService",
    "WhisperProvider"
   ],
   "purpose": "Auto-captions via OpenAI Whisper"
  },
  {
   "namespace": "Analytics",
   "key_classes": [
    "AnalyticsService",
    "AnalyticsController"
   ],
   "purpose": "Video heatmaps, play analytics, aggregation cron"
  },
  {
   "namespace": "Quota",
   "key_classes": [
    "QuotaService",
    "QuotaController",
    "AbstractQuotaAdapter",
    "MemberPressAdapter",
    "PaidMembershipsProAdapter",
    "WooCommerceAdapter"
   ],
   "purpose": "Upload/storage quotas (soft blocker for premium space limits), membership-plugin bridges via Integrations\\AbstractQuotaAdapter",
   "notes_1_6_0": "Default package applies to NEW registrations only; unassigned = unlimited. Lapsed subscriptions UNASSIGN (fires mvs_pro_quota_package_unassigned action). Legacy filters: mvs_pro_quota_default_applies_to_unassigned (read-time) + mvs_pro_quota_revert_to_default_on_end (write-time) - enable both or neither. Basecamp #9941320629."
  },
  {
   "namespace": "Storage",
   "key_classes": [
    "S3Driver",
    "BunnyCDNDriver"
   ],
   "purpose": "Cloud storage backends"
  },
  {
   "namespace": "AI",
   "key_classes": [
    "GoogleVisionProvider",
    "RekognitionProvider",
    "CircuitBreaker"
   ],
   "purpose": "Image recognition with rate-limit circuit breaker"
  },
  {
   "namespace": "Connectors",
   "key_classes": [
    "ConnectorManager",
    "ConnectorRESTController",
    "FlickrConnector",
    "OAuthHelper"
   ],
   "purpose": "Platform connectors with OAuth + delta-sync"
  },
  {
   "namespace": "Privacy",
   "key_classes": [
    "PrivacyUIService",
    "PrivacyController"
   ],
   "purpose": "Advanced privacy controls UI"
  },
  {
   "namespace": "Frontend",
   "key_classes": [
    "UsageWidget",
    "InstagramFeedService",
    "LayoutManager",
    "GamificationTemplateLoader",
    "InstagramLayout",
    "PinterestLayout",
    "FlickrLayout",
    "DribbbleLayout",
    "LeaderboardRenderer",
    "CompeteHubRenderer"
   ],
   "purpose": "Frontend layouts (Instagram/Pinterest/Flickr/Dribbble \u2014 each implements LayoutMode::render_feed() since 1.2.0 Phase 3a), gamification template rendering, leaderboard + compete-hub renderers (Phase 3b \u2014 string-returning, consumed by blocks + shortcodes)"
  },
  {
   "namespace": "Blocks",
   "key_classes": [
    "BlockRegistrar",
    "Shortcodes",
    "StandardAttributes",
    "MVS_CSS"
   ],
   "purpose": "1.2.0 Phase 3c\u20133e: registers 12 Pro Gutenberg blocks (BlockRegistrar::BLOCKS); registers 12 matching shortcodes (Shortcodes::init); injects the 20 standard layout/spacing/border/shadow/visibility attributes into every Pro block (StandardAttributes::inject via block_type_metadata filter); emits per-instance scoped CSS in wp_footer (MVS_CSS::add / output) keyed off mvs-block-{uniqueId}"
  },
  {
   "namespace": "Tournaments",
   "key_classes": [
    "Renderer"
   ],
   "purpose": "1.2.0 Phase 3b: string-returning renderer for the pro-tournament + pro-tournaments-list blocks/shortcodes; buffers templates/tournaments-body.php and seeds mvs_tournament_id query var"
  },
  {
   "namespace": "Challenges",
   "key_classes": [
    "Renderer"
   ],
   "purpose": "1.2.0 Phase 3b: string-returning renderer for the pro-challenge + pro-challenges-list blocks/shortcodes; buffers templates/challenges-body.php and seeds mvs_challenge_id query var"
  },
  {
   "namespace": "Battles",
   "key_classes": [
    "Renderer"
   ],
   "purpose": "1.2.0 Phase 3b: string-returning renderer for the pro-battle + pro-battles-active blocks/shortcodes; buffers templates/battles-body.php and seeds mvs_battle_id query var"
  },
  {
   "namespace": "Integrations",
   "key_classes": [
    "AbstractMigrationAdmin",
    "AbstractBatchImporter",
    "RtMedia\\MigrationAdmin",
    "MediaPress\\MigrationAdmin",
    "BuddyBoss\\MigrationAdmin"
   ],
   "purpose": "1.2.0 Phase 5: shared base classes + per-platform MigrationAdmin cards. AbstractMigrationAdmin (P2.1) defines the contract for the 3 platform-specific admin cards hosted by Admin/MigrationPage. AbstractBatchImporter (P2.2) is the WP-CLI base extended by Integrations/{RtMedia,MediaPress,BuddyBoss}/Importer.php."
  }
 ],
