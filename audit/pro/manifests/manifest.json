    "purpose": "Tournaments list/create"
   },
   {
    "route": "/tournaments/(?P<id>\\d+)",
    "methods": [
     "GET"
    ],
    "handler": "Tournaments/TournamentController::get_item",
    "permission": "public",
    "purpose": "Tournament detail"
   },
   {
    "route": "/tournaments/(?P<id>\\d+)/bracket",
    "methods": [
     "GET"
    ],
    "handler": "Tournaments/TournamentController::get_bracket",
    "permission": "public",
    "purpose": "Bracket data"
   },
   {
    "route": "/tournaments/(?P<id>\\d+)/register",
    "methods": [
     "POST"
    ],
    "handler": "Tournaments/TournamentController::register_item",
    "permission": "logged-in",
    "purpose": "Register participant"
   },
   {
    "route": "/tournaments/(?P<id>\\d+)/matches/(?P<match_id>\\d+)/vote",
    "methods": [
     "POST"
    ],
    "handler": "Tournaments/TournamentController::vote_match",
    "permission": "logged-in",
    "purpose": "Vote on match"
   },
   {
    "route": "/me/quota",
    "methods": [
     "GET"
    ],
    "handler": "Quota/QuotaController::get_my_quota",
    "permission": "logged-in",
    "purpose": "My quota"
   },
   {
    "route": "/users/(?P<user_id>\\d+)/quota",
