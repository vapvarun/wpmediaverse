   {
    "route": "/me/boosts",
    "methods": [
     "GET"
    ],
    "handler": "Boosts/BoostController::get_my_boosts",
    "permission": "logged-in",
    "purpose": "My boosts"
   },
   {
    "route": "/boosts",
    "methods": [
     "POST"
    ],
    "handler": "Boosts/BoostController::create_boost",
    "permission": "logged-in",
    "purpose": "Create boost"
   },
   {
    "route": "/captions/(?P<media_id>\\d+)",
    "methods": [
     "GET",
     "POST"
    ],
    "handler": "Captions/CaptionController",
    "permission": "media owner/admin",
    "purpose": "Captions get/transcribe"
   },
   {
    "route": "/transcode",
    "methods": [
     "POST"
    ],
    "handler": "Video/TranscodeController::start_transcode",
    "permission": "admin",
    "purpose": "Start transcode job"
   },
   {
    "route": "/transcode/(?P<job_id>\\d+)",
    "methods": [
     "GET"
    ],
    "handler": "Video/TranscodeController::get_status",
    "permission": "admin",
    "purpose": "Job status"
   },
   {
    "route": "/videos/(?P<id>\\d+)/chapters",
    "methods": [
     "GET"
    ],
    "handler": "Video/VideoController::get_chapters",
    "permission": "public",
    "purpose": "Video chapters"
   },
   {
    "route": "/videos/(?P<id>\\d+)/resume",
    "methods": [
