includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - includes/
    scanFiles:
        - wpmediaverse.php
        # Action Scheduler is bundled under libs/ rather than installed by
        # Composer, so PHPStan no longer discovers its global as_*() API through
        # the vendor autoloader. Three services call it behind function_exists().
        - libs/action-scheduler/functions.php
    ignoreErrors:
        -
            message: '#(BuddyPress|bp_|BP_)#'
            reportUnmatched: false
        # WP_CLI is provided by the WP-CLI runtime, not analysable by PHPStan
        # (same treatment the baseline gives includes/CLI/Commands.php).
        -
            message: '#^Call to static method \w+\(\) on an unknown class WP_CLI\.$#'
            path: includes/Cert/CertCommand.php
            reportUnmatched: false
