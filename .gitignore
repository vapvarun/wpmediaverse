node_modules/

# dist/ — only commit the final release ZIPs (e.g. wpmediaverse-1.2.0.zip).
# The extracted plugin tree under dist/<slug>/ is a build artifact that
# gets fully recreated on every `npx grunt dist` run; tracking it bloats
# the repo with thousands of derived-file diffs.
dist/*/

*.log
.DS_Store

# Playwright e2e probe fixtures — tests/e2e/documents-qa-full-member.spec.ts
# generates one of these per run (TAG = `FULL${Date.now()}`, written via
# execFileSync to prove the default-privacy path) and never cleans it up.
# The other files in tests/e2e/fixtures/ (pw-doc-fixture.*, pw-too-large.*,
# pw-disallowed.pptx, pw-searchable.txt) are real, static, spec-referenced
# fixtures and stay tracked — only the timestamped probes are ignored.
# 5 accumulated and got committed once (2026-08-11) before this rule existed;
# removed in that same commit.
tests/e2e/fixtures/pw-priv-FULL*.txt
.phpunit.result.cache
.phpunit.cache
CLAUDE.md
.claude/

# Dev reports
wpcs-report.md

# Unused webpack side-output.
#
# `wp-scripts build --experimental-modules` emits two bundles per block:
#   1. An ES module at build/blocks/<name>/view.js (referenced by
#      block.json `viewScriptModule`, used at runtime).
#   2. A legacy IIFE at build/blocks/blocks/<name>/view.js (never
#      referenced — dead fallback for non-module environments).
#
# The legacy output is not used by any block.json in this plugin, so it
# is ignored here to keep it out of commits. The top-level build/<name>/
# entries cover another pattern: running `wp-scripts build` without
# `--webpack-src-dir=src/blocks` scans the whole `src/` tree and emits
# output at build/<name>/ instead of build/blocks/<name>/. These should
# never be committed either.
/build/blocks/blocks/
/build/album-viewer/
/build/dashboard-view/
/build/explore-feed/
/build/explore-view/
/build/lock-overlay/
/build/media-grid/
/build/media-player/
/build/media-social/
/build/media-stats/
/build/media-upload/
/build/shared-ui/
/build/story-viewer/
.claude-tmp/
audit/journey-runs/

# Playwright (Phase 0c E2E specs)
playwright-report/
test-results/
.playwright-mcp/

# Transient pre-release smoke debug-log archives (evidence only, not shipped)
qa/.debug-log-*.txt

# Minified assets — build output, not source.
#
# Every *.min.css / *.min.js under assets/ and templates/ is produced by
# `grunt build` (cssmin + uglify) from the unminified file beside it, and
# `grunt dist` runs build before packaging, so the release ZIP still contains
# them. Tracking them added nothing but churn: they were regenerated on every
# build and drifted a month stale against their sources without anyone
# noticing, because nothing loads them.
#
# Verified by deleting all 26 tracked .min files and rebuilding: 18 came back
# from grunt, 8 did not. The 8 are third-party and stay tracked — see the
# negation below and phpunit's bundled assets under vendor/.
assets/**/*.min.css
assets/**/*.min.js
templates/**/*.min.js
templates/**/*.min.css

# ...except vendored libraries, which are shipped as-is and have no source
# here to regenerate from. assets/js/vendor/lucide.min.js IS enqueued
# (the `mvs-lucide` handle, Plugin::register_lucide_script).
!assets/js/vendor/*.min.js
!assets/js/vendor/*.min.css
