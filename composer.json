{
    "name": "wbcomdesigns/wpmediaverse",
    "description": "A general-purpose WordPress media platform plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "repositories": {
        "edd-sl-sdk": {
            "type": "vcs",
            "url": "https://github.com/vapvarun/edd-sl-sdk"
        }
    },
    "require": {
        "php": ">=7.4",
        "woocommerce/action-scheduler": "^3.7",
        "easy-digital-downloads/edd-sl-sdk": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "WPMediaVerse\\": "includes/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/wordpress-stubs": "^6.4"
    },
    "scripts": {
        "ci": "bash bin/local-ci.sh",
        "ci:quick": "bash bin/local-ci.sh --quick",
        "ci:no-journeys": "bash bin/local-ci.sh --no-journeys",
        "journeys": "bash bin/run-journeys.sh",
        "journeys:critical": "bash bin/run-journeys.sh --priority critical",
        "journeys:dry-run": "bash bin/run-journeys.sh --dry-run",
        "coding-rules": "bash bin/coding-rules-check.sh",
        "arch-checks": "bash bin/architecture-checks.sh",
        "test:contract": "vendor/bin/phpunit --filter SettingsContractTest",
        "install-hooks": "git config core.hooksPath bin/git-hooks && echo 'Pre-push hook installed (bypass with SKIP_LOCAL_CI=1)'"
    }
}
