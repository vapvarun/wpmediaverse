msgid "Duplicate Detection"
msgstr "Detectie van dubbele bestanden"

#: includes/Admin/Settings/GeneralSettingsRegistrar.php:223
msgid "Warn (allow upload)"
msgstr "Waarschuwen (upload toestaan)"

#: includes/Admin/Settings/GeneralSettingsRegistrar.php:224
