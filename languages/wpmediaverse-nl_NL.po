msgid "Allow Users to Set Privacy"
msgstr "Gebruikers privacy laten instellen"

#: includes/Admin/Settings/GeneralSettingsRegistrar.php:200
msgid "Let members choose"
msgstr "Leden laten kiezen"

#: includes/Admin/Settings/GeneralSettingsRegistrar.php:201
msgid ""
"Members choose who sees each upload. Off: every upload uses the default "
"above."
msgstr ""
"Leden kiezen wie elke upload ziet. Uit: elke upload gebruikt het "
"standaardniveau hierboven."

