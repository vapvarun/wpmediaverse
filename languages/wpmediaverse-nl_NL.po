msgid "Remove Data on Delete"
msgstr "Gegevens verwijderen bij deïnstallatie"

#: includes/Admin/Settings/GeneralSettingsRegistrar.php:391
msgid "Delete all MediaVerse data when the plugin is deleted."
msgstr "Verwijdert alle MediaVerse-gegevens wanneer de plugin wordt verwijderd."

