msgid "Send this email"
msgstr "Deze e-mail versturen"

#: includes/Admin/Settings/GeneralSettingsRegistrar.php:349
msgid "Only logged-in members can see WP MediaVerse"
msgstr "Alleen ingelogde leden kunnen WP MediaVerse zien"

#: includes/Admin/Settings/GeneralSettingsRegistrar.php:350
