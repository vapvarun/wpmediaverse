msgstr "Upload blokkeren"

#: includes/Admin/Settings/GeneralSettingsRegistrar.php:225
msgid "Allow (no check)"
msgstr "Toestaan (geen controle)"

#: includes/Admin/Settings/GeneralSettingsRegistrar.php:227
